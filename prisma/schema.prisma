generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  buyer
  merchant
  admin
  supplier
}

enum POStatus {
  draft
  sent
  confirmed
  shipped
  received
  cancelled
}

enum ProductSource {
  voice
  image
  excel
  manual
}

enum ProductUnit {
  kg
  gram
  tonne
  litre
  ml
  meter
  cm
  pack
  box
  pair
  piece
  set
  dozen
  bottle
  other
}

enum OrderStatus {
  draft
  confirmed
  paid
  failed
  fulfilled
  cancelled
}

enum PaymentStatus {
  created
  captured
  failed
  refunded
}

enum PaymentMethod {
  razorpay
}

enum StoreStatus {
  active
  inactive
  suspended
}

enum StaffRole {
  manager
  cashier
  delivery
  inventory
}

enum StaffStatus {
  pending
  active
  inactive
}


model User {
  id                String   @id @default(uuid())
  role              UserRole
  name              String
  phone             String   @unique
  preferredLanguage String   @default("en") @map("preferred_language")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  stores Store[] @relation("MerchantStores")

  orders Order[] @relation("BuyerOrders")
  supplierProfile Supplier? @relation("SupplierUser")
  carts  Cart[]

  @@map("users")
}


model Store {
  id           String      @id @default(uuid())
  ownerId      String      @map("owner_id")


  name         String
  description  String?
  legalName    String?     @map("legal_name")
  tradingName  String?     @map("trading_name")
  taxId        String?     @map("tax_id")
  vatNumber    String?     @map("vat_number")
  businessEmail String?    @map("business_email")
  supportPhone String?     @map("support_phone")
  bannerUrl    String?     @map("banner_url")
  logoUrl      String?     @map("logo_url")
  themeColor   String?     @map("theme_color")

  businessType String      @map("business_type")

  // Location
  address      String
  city         String?
  state        String?
  pincode      String?
  unit         String?
  deliveryEnabled Boolean @default(true) @map("delivery_enabled")
  deliveryRadius Float?   @map("delivery_radius")
  lat          Float
  lng          Float

  status       StoreStatus @default(active)

  // Payments & Bank
  bankAccountNumber String?  @map("bank_account_number")
  bankIfsc          String?  @map("bank_ifsc")
  upiId             String?  @map("upi_id")

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  owner          User            @relation("MerchantStores", fields: [ownerId], references: [id])
  products       Product[]
  orders         Order[]
  staff          StoreStaff[]
  purchaseOrders PurchaseOrder[]
  carts          Cart[]

  @@index([ownerId])
  @@index([businessType])
  @@index([city])
  @@index([lat, lng])
  @@map("stores")
}

model StoreStaff {
  id        String      @id @default(uuid())
  storeId   String      @map("store_id")
  
  name      String
  phone     String
  role      StaffRole   @default(cashier)
  status    StaffStatus @default(pending)
  
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, phone])
  @@index([storeId])
  @@index([phone])
  @@map("store_staff")
}



model Product {
  id          String        @id @default(uuid())
  storeId     String        @map("store_id")

  name        String
  description String?

  category    String
  subcategory String?

  unit        ProductUnit
  price       Decimal       @db.Decimal(10, 2)
  stockQty    Decimal       @default(0) @map("stock_qty") @db.Decimal(10, 2)

  sku         String?

  imageUrl    String?       @map("image_url")

  attributes  Json?

  source      ProductSource @default(manual)

  isActive    Boolean       @default(true) @map("is_active")

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  store              Store               @relation(fields: [storeId], references: [id])
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  carts              Cart[]

  @@index([storeId])
  @@index([storeId, name])
  @@index([category])
  @@index([subcategory])
  @@index([name])
  @@map("products")
}


model Order {
  id          String      @id @default(uuid())

  buyerId     String      @map("buyer_id")
  storeId     String      @map("store_id")

  status      OrderStatus @default(draft)


  totalAmount Decimal     @default(0) @map("total_amount") @db.Decimal(10, 2)

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  buyer       User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  store       Store       @relation(fields: [storeId], references: [id])

  orderItems  OrderItem[]
  payment     Payment?

  @@index([buyerId])
  @@index([storeId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}


model OrderItem {
  id              String   @id @default(uuid())

  orderId         String   @map("order_id")
  productId       String   @map("product_id")

  qty             Decimal  @db.Decimal(10, 2)

  priceAtPurchase Decimal  @map("price_at_purchase") @db.Decimal(10, 2)

  createdAt       DateTime @default(now()) @map("created_at")

  order           Order    @relation(fields: [orderId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}



model Payment {
  id                 String        @id @default(uuid())

  orderId            String        @unique @map("order_id")

  razorpayOrderId    String?       @map("razorpay_order_id")
  razorpayPaymentId  String?       @map("razorpay_payment_id")

  status             PaymentStatus @default(created)
  method             PaymentMethod @default(razorpay)

  amount             Decimal       @db.Decimal(10, 2)

  capturedAt         DateTime?     @map("captured_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  order              Order         @relation(fields: [orderId], references: [id])

  @@index([status])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@map("payments")
}


model Supplier {
  id           String      @id @default(uuid())
  userId       String?     @unique @map("user_id")
  name         String
  companyName  String?     @map("company_name")
  phone        String
  email        String?
  category     String?
  address      String?
  city         String?
  state        String?
  pincode      String?
  gstin        String?
  rating       Float       @default(5.0)
  paymentTerms String?     @map("payment_terms")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user           User?             @relation("SupplierUser", fields: [userId], references: [id])
  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  @@index([category])
  @@index([city])
  @@map("suppliers")
}

model SupplierProduct {
  id             String      @id @default(uuid())
  supplierId     String      @map("supplier_id")
  name           String
  description    String?
  category       String
  subcategory    String?
  unit           ProductUnit @default(piece)
  wholesalePrice Decimal     @map("wholesale_price") @db.Decimal(10, 2)
  minOrderQty    Decimal     @default(1) @map("min_order_qty") @db.Decimal(10, 2)
  sku            String?
  imageUrl       String?     @map("image_url")
  inStock        Boolean     @default(true) @map("in_stock")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  supplier       Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([category])
  @@index([name])
  @@map("supplier_products")
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  poNumber         String              @unique @map("po_number")
  storeId          String              @map("store_id")
  supplierId       String              @map("supplier_id")
  status           POStatus            @default(draft)
  totalAmount      Decimal             @default(0) @map("total_amount") @db.Decimal(10, 2)
  notes            String?
  expectedDelivery DateTime?           @map("expected_delivery")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  store            Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items            PurchaseOrderItem[]

  @@index([storeId])
  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String        @id @default(uuid())
  purchaseOrderId   String        @map("purchase_order_id")
  productId         String?       @map("product_id")
  supplierProductId String?       @map("supplier_product_id")
  name              String
  qty               Decimal       @db.Decimal(10, 2)
  unitPrice         Decimal       @map("unit_price") @db.Decimal(10, 2)
  totalPrice        Decimal       @map("total_price") @db.Decimal(10, 2)
  createdAt         DateTime      @default(now()) @map("created_at")

  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  storeId   String   @map("store_id")
  productId String   @map("product_id")
  qty       Decimal  @default(1) @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, storeId])
  @@index([userId])
  @@index([storeId])
  @@index([productId])
  @@map("carts")
}